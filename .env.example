# ============================================================
# AI DAN SOLUTIONS — Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena los valores.
# NOTA: Para la app estática, estos valores se configuran en:
#   procesados/_shared/config.js
# Este .env es referencia para documentación y despliegue futuro.
# ============================================================

# Supabase — Dashboard > Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...tu-anon-key

# NUNCA exponer en el frontend:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...solo-backend

# Google OAuth — Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# WhatsApp de contacto (código país + número)
WHATSAPP_NUMBER=51XXXXXXXXX

# URL de la aplicación (para redirect OAuth)
SITE_URL=http://localhost:8000
